# Maintainer: Victor Pham <https://github.com/victorpham1995/lotuskey>
pkgname=ibus-lotuskey
pkgver=2.2.1
pkgrel=1
pkgdesc="Vietnamese Input Method Engine for Linux (IBus / Fcitx5 / UInput)"
arch=('x86_64')
url="https://github.com/victorpham1995/lotuskey"
license=('MIT')
depends=('ibus' 'glib2' 'gtk3' 'python' 'python-gobject')
optdepends=('fcitx5: Fcitx5 Input Method Framework support')
makedepends=('gcc' 'pkgconf')
options=('!strip' '!debug')
install=ibus-lotuskey.install
source=()

build() {
    cd "${startdir}/.."
    packaging/build_binaries.sh
}

package() {
    cd "${startdir}/.."
    packaging/stage_install.sh "${pkgdir}" /usr/lib/udev/rules.d
}
